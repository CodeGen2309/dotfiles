// DMS Window Rules - Managed by Dux Shell
// Do not edit manually - changes may be overwritten

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    open-floating true
}

// @id=dms-window-opaque @name=DMS Window Opaque
window-rule {
    match app-id="^(dev\\.duxlabs\\.shell|com\\.danklinux\\.dms)$"
    opacity 1.00
}


window-rule {
	// This app-id regular expression will work for both:
	// - host Firefox (app-id is "firefox")
	// - Flatpak Firefox (app-id is "org.mozilla.firefox")
	match app-id=r"firefox$" title="^Picture-in-Picture$"
	open-floating true
}


window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
    draw-border-with-background false
}


window-rule {
	match app-id="obsidian"
	match app-id="code-oss"
	opacity 0.9
}


window-rule {
	match app-id="Alacritty"
	match app-id="nemo"
	match app-id="org.gnome.Nautilus"
	match app-id="org.qbittorrent.qBittorrent"
	open-floating true
	opacity 0.9
	default-column-width { proportion 0.7; }
  default-window-height { proportion 0.7; }
}


window-rule {
	match app-id="PortProton"
	match app-id="waypaper"
	open-floating true
}


/-window-rule {
	match app-id="ranger"
	match app-id="nemo"
	open-on-workspace "special"
}
